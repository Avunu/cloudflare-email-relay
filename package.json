{
	"name": "@avunu/cloudflare-email-relay",
	"version": "2.0.0",
	"description": "Multi-tenant Cloudflare Email Routing relay: stores every inbound message in R2 and pushes it to the owning Odoo or Frappe instance over signed HTTPS with durable per-tenant retries. Consumed by the deployment fleet's thin wrappers.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Avunu/cloudflare-email-relay.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tenants": {
			"types": "./dist/tenant-schema.d.ts",
			"import": "./dist/tenant-schema.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"typecheck:integration": "tsc -p test/integration/tsconfig.json --noEmit",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"lint:typecheck": "oxlint --type-aware -c .oxlintrc.typecheck.json .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "npm run format:check && npm run lint && npm run lint:typecheck && npm run typecheck && npm run typecheck:integration",
		"dev": "wrangler dev",
		"types": "wrangler types",
		"test": "vitest run -c vitest.config.ts && vitest run -c vitest.integration.config.ts",
		"test:unit": "vitest run -c vitest.config.ts",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"prepublishOnly": "npm run build",
		"upgrade": "npx npm-check-updates -u -x vitest && npm install && npm audit fix"
	},
	"dependencies": {
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260919.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2002",
		"typescript": "^7.0.2",
		"vitest": "^4",
		"wrangler": "^4.135.0"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "*"
	},
	"peerDependenciesMeta": {
		"@cloudflare/workers-types": {
			"optional": true
		}
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260815.1": true,
		"workerd@1.20260915.1": true
	}
}
